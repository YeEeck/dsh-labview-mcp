{
  "name": "dsh-labview-mcp",
  "version": "1.0.0",
  "description": "Unofficial DSH bundle for Zuehlke's LabVIEW MCP server",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "status-routes.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "LICENSE-Zuehlke.txt",
    "LICENSE-pylabview.txt",
    "THIRD-PARTY-NOTICES.md"
  ],
  "optionalDependencies": {
    "dsh-labview-mcp-win32-x64": "~3.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
